#compdef switchboard

autoload -U is-at-least

_switchboard() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_switchboard_commands" \
"*::: :->switchboard" \
&& ret=0
    case $state in
    (switchboard)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:switchboard-command-$line[1]:"
        case $line[1] in
            (read-batch)
_arguments "${_arguments_options[@]}" : \
'--input=[JSON object containing an items array of {id, tool, namespace, args}]:INPUT:_files' \
'--checkpoint=[Durable results; successful pages are saved after each bounded wave]:CHECKPOINT:_files' \
'--concurrency=[]:CONCURRENCY:_default' \
'--deadline-seconds=[]:DEADLINE_SECONDS:_default' \
'--max-pages=[]:MAX_PAGES:_default' \
'--config=[]:PATH:_files' \
'--resume[]' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(ns)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_switchboard__subcmd__ns_commands" \
"*::: :->ns" \
&& ret=0

    case $state in
    (ns)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:switchboard-ns-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--ns=[Inspect one namespace instead of all configured namespaces]:NAMESPACE:_default' \
'--config=[]:PATH:_files' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(auth)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_switchboard__subcmd__auth_commands" \
"*::: :->auth" \
&& ret=0

    case $state in
    (auth)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:switchboard-auth-command-$line[1]:"
        case $line[1] in
            (check)
_arguments "${_arguments_options[@]}" : \
'--ns=[]:NAMESPACE:_default' \
'--run-id=[Share the one-recovery-attempt budget across commands in this task]:RUN_ID:_default' \
'--config=[]:PATH:_files' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(migration-preview)
_arguments "${_arguments_options[@]}" : \
'--ns=[]:NAMESPACE:_default' \
'--config=[]:PATH:_files' \
'--verify[Verify the saved CLI session through a live read before changing config]' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(tools)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_switchboard__subcmd__tools_commands" \
"*::: :->tools" \
&& ret=0

    case $state in
    (tools)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:switchboard-tools-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--provider=[Filter by provider identifier, for example google or github]:PROVIDER:_default' \
'--ns=[Filter by a configured namespace without resolving credentials]:NAMESPACE:_default' \
'--search=[Search tool names and summaries (case insensitive)]:SEARCH:_default' \
'--config=[]:PATH:_files' \
'--json[]' \
'--executable[Include only tools with an implemented execution path]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(describe)
_arguments "${_arguments_options[@]}" : \
'--ns=[Use this configured namespace in examples]:NAMESPACE:_default' \
'--config=[]:PATH:_files' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
':tool:_default' \
&& ret=0
;;
        esac
    ;;
esac
;;
(audit)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_switchboard__subcmd__audit_commands" \
"*::: :->audit" \
&& ret=0

    case $state in
    (audit)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:switchboard-audit-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--operation-id=[]:OPERATION_ID:_default' \
'--config=[]:PATH:_files' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
':selector:_default' \
&& ret=0
;;
        esac
    ;;
esac
;;
(op)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_switchboard__subcmd__op_commands" \
"*::: :->op" \
&& ret=0

    case $state in
    (op)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:switchboard-op-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'--pending[]' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
':id:_default' \
&& ret=0
;;
(approve)
_arguments "${_arguments_options[@]}" : \
'--actor=[]:ACTOR:_default' \
'--note=[]:NOTE:_default' \
'--config=[]:PATH:_files' \
'--apply[]' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
':id:_default' \
&& ret=0
;;
(reject)
_arguments "${_arguments_options[@]}" : \
'--actor=[]:ACTOR:_default' \
'--note=[]:NOTE:_default' \
'--config=[]:PATH:_files' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
':id:_default' \
&& ret=0
;;
(apply)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
':id:_default' \
&& ret=0
;;
(verify)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
':id:_default' \
&& ret=0
;;
(undo)
_arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'--apply[]' \
'--json[]' \
'-h[Print help]' \
'--help[Print help]' \
':id:_default' \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_switchboard_commands] )) ||
_switchboard_commands() {
    local commands; commands=(
'read-batch:Execute bounded read-only requests with durable, resumable page results' \
'ns:' \
'doctor:Inspect configuration, saved state, and CLI availability without authenticating' \
'auth:Verify provider authentication or preview adoption of an existing CLI session' \
'tools:' \
'audit:' \
'op:' \
    )
    _describe -t commands 'switchboard commands' commands "$@"
}
(( $+functions[_switchboard__subcmd__audit_commands] )) ||
_switchboard__subcmd__audit_commands() {
    local commands; commands=(
'list:' \
'show:' \
    )
