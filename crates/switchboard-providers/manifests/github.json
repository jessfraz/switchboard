{
  "provider": "github",
  "binaries": [
    {
      "id": "gh",
      "program": "gh",
      "env_override": "SWITCHBOARD_GH_BIN",
      "version_args": ["--version"]
    }
  ],
  "capabilities": [
    {
      "id": "gh_help",
      "args": ["--help"]
    },
    {
      "id": "gh_api",
      "args": ["api", "--help"]
    },
    {
      "id": "gh_search_prs",
      "args": ["search", "prs", "--help"]
    },
    {
      "id": "gh_search_repos",
      "args": ["search", "repos", "--help"]
    },
    {
      "id": "gh_pr_view",
      "args": ["pr", "view", "--help"]
    },
    {
      "id": "gh_issue_view",
      "args": ["issue", "view", "--help"]
    }
  ],
  "commands": [
    {
      "name": "github.notifications.list",
      "kind": "read",
      "summary": "List notifications for a GitHub namespace",
      "strategy": { "kind": "handler", "id": "notifications_list" },
      "execution": {
        "kind": "executable",
        "binary": "gh",
        "capability": "gh_api"
      }
    },
    {
      "name": "github.pull_request.read",
      "kind": "read",
      "summary": "Read a pull request",
      "strategy": {
        "kind": "summary_template",
        "template": "Read GitHub pull request {arg:repo}#{arg:number} in {namespace}"
      },
      "execution": {
        "kind": "executable",
        "binary": "gh",
        "capability": "gh_pr_view"
      },
      "args": {
        "kind": "template",
        "segments": [
          { "kind": "literal", "value": "pr" },
          { "kind": "literal", "value": "view" },
          { "kind": "required_positional", "aliases": ["number"] },
          { "kind": "option", "flag": "--repo", "aliases": ["repo"], "required": true },
          { "kind": "literal", "value": "--json" },
          {
            "kind": "literal",
            "value": "id,number,title,body,state,isDraft,author,assignees,labels,baseRefName,headRefName,reviewDecision,mergeStateStatus,createdAt,updatedAt,url"
          }
        ]
      },
      "decode": {
        "kind": "json_projection",
        "response_field": "pull_request",
        "shape": "object",
        "summary_template": "Read GitHub pull request \"{field:title}\" for {namespace}",
        "fields": [
          { "name": "id", "pointer": "/id" },
          { "name": "number", "pointer": "/number" },
          { "name": "repository", "arg": ["repo"] },
          { "name": "title", "pointer": "/title" },
          { "name": "body", "pointer": "/body" },
          { "name": "state", "pointer": "/state" },
          { "name": "is_draft", "pointer": "/isDraft" },
          { "name": "author", "pointer": "/author/login" },
          { "name": "assignees", "pointer": "/assignees", "item_pointer": "/login" },
          { "name": "labels", "pointer": "/labels", "item_pointer": "/name" },
          { "name": "base_ref_name", "pointer": "/baseRefName" },
          { "name": "head_ref_name", "pointer": "/headRefName" },
          { "name": "review_decision", "pointer": "/reviewDecision" },
          { "name": "merge_state_status", "pointer": "/mergeStateStatus" },
          { "name": "created_at", "pointer": "/createdAt" },
          { "name": "updated_at", "pointer": "/updatedAt" },
          { "name": "url", "pointer": "/url" }
        ],
        "refs": {
          "kind": "pull_request",
          "id_field": "number",
          "parent_id_field": "repository",
          "label_field": "title",
          "url_field": "url"
        }
      }
    },
    {
      "name": "github.pull_request.search",
      "kind": "read",
      "summary": "Search pull requests",
      "strategy": {
        "kind": "summary_template",
        "template": "Search GitHub pull requests in {namespace} for {arg:query}"
      },
      "execution": {
        "kind": "executable",
        "binary": "gh",
        "capability": "gh_search_prs"
      },
      "args": {
        "kind": "template",
        "segments": [
          { "kind": "literal", "value": "search" },
          { "kind": "literal", "value": "prs" },
          { "kind": "required_positional", "aliases": ["query"] },
          { "kind": "literal", "value": "--json" },
          {
            "kind": "literal",
            "value": "id,number,title,state,isDraft,repository,author,createdAt,updatedAt,url"
          },
          { "kind": "option", "flag": "--limit", "aliases": ["limit"] },
          { "kind": "option", "flag": "--state", "aliases": ["state"] },
          { "kind": "option", "flag": "--repo", "aliases": ["repo"] },
          { "kind": "option", "flag": "--owner", "aliases": ["owner"] },
          { "kind": "option", "flag": "--author", "aliases": ["author"] },
          { "kind": "option", "flag": "--assignee", "aliases": ["assignee"] },
          { "kind": "option", "flag": "--review-requested", "aliases": ["review-requested"] },
          { "kind": "option", "flag": "--sort", "aliases": ["sort"] },
          { "kind": "option", "flag": "--order", "aliases": ["order"] },
          { "kind": "option", "flag": "--base", "aliases": ["base"] },
          { "kind": "option", "flag": "--head", "aliases": ["head"] },
          { "kind": "flag", "flag": "--draft", "aliases": ["draft"] },
          { "kind": "flag", "flag": "--merged", "aliases": ["merged"] }
        ]
      },
      "decode": {
        "kind": "json_projection",
        "response_field": "pull_requests",
        "shape": "array",
        "count_field": "count",
        "summary_template": "Found {count} GitHub pull requests for {namespace}",
        "fields": [
          { "name": "id", "pointer": "/id" },
          { "name": "number", "pointer": "/number" },
          { "name": "title", "pointer": "/title" },
          { "name": "state", "pointer": "/state" },
          { "name": "is_draft", "pointer": "/isDraft" },
          { "name": "repository", "pointer": "/repository/nameWithOwner" },
          { "name": "author", "pointer": "/author/login" },
          { "name": "created_at", "pointer": "/createdAt" },
          { "name": "updated_at", "pointer": "/updatedAt" },
          { "name": "url", "pointer": "/url" }
        ],
        "refs": {
          "kind": "pull_request",
          "id_field": "number",
          "parent_id_field": "repository",
          "label_field": "title",
          "url_field": "url"
        }
      }
    },
    {
      "name": "github.pull_request.comment",
      "kind": "write",
      "summary": "Draft or send a pull request comment",
      "strategy": {
        "kind": "summary_template",
        "template": "Draft comment for pull request {arg:repo}#{arg:number} in {namespace}"
      },
      "execution": {
        "kind": "planning_only"
      }
    },
    {
      "name": "github.issue.read",
      "kind": "read",
      "summary": "Read an issue",
      "strategy": {
        "kind": "summary_template",
        "template": "Read GitHub issue {arg:repo}#{arg:number} in {namespace}"
      },
      "execution": {
        "kind": "executable",
        "binary": "gh",
        "capability": "gh_issue_view"
      },
      "args": {
        "kind": "template",
        "segments": [
          { "kind": "literal", "value": "issue" },
          { "kind": "literal", "value": "view" },
          { "kind": "required_positional", "aliases": ["number"] },
          { "kind": "option", "flag": "--repo", "aliases": ["repo"], "required": true },
          { "kind": "literal", "value": "--json" },
          {
            "kind": "literal",
            "value": "id,number,title,body,state,stateReason,author,assignees,labels,createdAt,updatedAt,url"
          }
        ]
      },
      "decode": {
        "kind": "json_projection",
        "response_field": "issue",
        "shape": "object",
        "summary_template": "Read GitHub issue \"{field:title}\" for {namespace}",
        "fields": [
          { "name": "id", "pointer": "/id" },
          { "name": "number", "pointer": "/number" },
          { "name": "repository", "arg": ["repo"] },
          { "name": "title", "pointer": "/title" },
          { "name": "body", "pointer": "/body" },
          { "name": "state", "pointer": "/state" },
          { "name": "state_reason", "pointer": "/stateReason" },
          { "name": "author", "pointer": "/author/login" },
          { "name": "assignees", "pointer": "/assignees", "item_pointer": "/login" },
          { "name": "labels", "pointer": "/labels", "item_pointer": "/name" },
          { "name": "created_at", "pointer": "/createdAt" },
          { "name": "updated_at", "pointer": "/updatedAt" },
          { "name": "url", "pointer": "/url" }
        ],
        "refs": {
          "kind": "issue",
          "id_field": "number",
          "parent_id_field": "repository",
          "label_field": "title",
          "url_field": "url"
        }
      }
    },
    {
      "name": "github.issue.comment",
      "kind": "write",
      "summary": "Draft or send an issue comment",
      "strategy": {
        "kind": "summary_template",
        "template": "Draft comment for issue {arg:repo}#{arg:number} in {namespace}"
      },
      "execution": {
        "kind": "planning_only"
      }
    },
    {
      "name": "github.repository.search",
      "kind": "read",
      "summary": "Search repositories",
      "strategy": {
        "kind": "summary_template",
        "template": "Search GitHub repositories matching {arg:query}"
      },
      "execution": {
        "kind": "executable",
        "binary": "gh",
        "capability": "gh_search_repos"
      },
      "args": {
        "kind": "template",
        "segments": [
          { "kind": "literal", "value": "search" },
          { "kind": "literal", "value": "repos" },
          { "kind": "required_positional", "aliases": ["query"] },
          { "kind": "literal", "value": "--json" },
          {
            "kind": "literal",
            "value": "id,name,fullName,description,language,stargazersCount,updatedAt,url,visibility,owner"
          },
          { "kind": "option", "flag": "--limit", "aliases": ["limit"] },
          { "kind": "option", "flag": "--owner", "aliases": ["owner"], "repeated": true },
          { "kind": "option", "flag": "--language", "aliases": ["language"] },
          { "kind": "option", "flag": "--sort", "aliases": ["sort"] },
          { "kind": "option", "flag": "--order", "aliases": ["order"] },
          { "kind": "option", "flag": "--topic", "aliases": ["topic"], "repeated": true },
          { "kind": "option", "flag": "--match", "aliases": ["match"], "repeated": true },
          { "kind": "option", "flag": "--visibility", "aliases": ["visibility"], "repeated": true },
          { "kind": "option", "flag": "--stars", "aliases": ["stars"] },
          { "kind": "option", "flag": "--forks", "aliases": ["forks"] },
          { "kind": "option", "flag": "--updated", "aliases": ["updated"] },
          { "kind": "option", "flag": "--created", "aliases": ["created"] }
        ]
      },
      "decode": {
        "kind": "json_projection",
        "response_field": "repositories",
        "shape": "array",
        "count_field": "count",
        "summary_template": "Found {count} GitHub repositories for {namespace}",
        "fields": [
          { "name": "id", "pointer": "/id" },
          { "name": "name", "pointer": "/name" },
          { "name": "full_name", "pointer": "/fullName" },
          { "name": "description", "pointer": "/description" },
          { "name": "language", "pointer": "/language" },
          { "name": "owner", "pointer": "/owner/login" },
          { "name": "stargazers_count", "pointer": "/stargazersCount" },
          { "name": "updated_at", "pointer": "/updatedAt" },
          { "name": "url", "pointer": "/url" },
          { "name": "visibility", "pointer": "/visibility" }
        ],
        "refs": {
          "kind": "repository",
          "id_field": "full_name",
          "label_field": "name",
          "url_field": "url"
        }
      }
    },
    {
      "name": "github.cli.read",
      "kind": "read",
      "summary": "Run a raw GitHub CLI read command",
      "surface": "raw",
      "strategy": { "kind": "raw_passthrough" },
      "execution": {
        "kind": "executable",
        "binary": "gh",
        "capability": "gh_help"
      }
    },
    {
      "name": "github.cli.write",
      "kind": "write",
      "summary": "Run a raw GitHub CLI write command",
      "surface": "raw",
      "strategy": { "kind": "raw_passthrough" },
      "execution": {
        "kind": "executable",
        "binary": "gh",
        "capability": "gh_help"
      }
    }
  ]
}
